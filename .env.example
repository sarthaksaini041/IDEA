# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ---- Ads (off by default) ----
# none | placeholder (layout testing only) | adsense
NEXT_PUBLIC_ADS_PROVIDER=none
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX (also drives /ads.txt)
NEXT_PUBLIC_AD_SLOT_IN_CONTENT=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_BELOW_RESULTS=
NEXT_PUBLIC_AD_SLOT_FOOTER=

# ---- Affiliate (optional; both OFF until set) ----
NEXT_PUBLIC_EPN_CAMPAIGN_ID=           # eBay Partner Network campaign id (10 digits)
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=      # Amazon Associates tracking ID, e.g. yourtag-20 (format-checked; invalid = disabled)
NEXT_PUBLIC_AMAZON_HOST=               # optional storefront, default www.amazon.com

# ---- Analytics (cookieless; optional) ----
# plausible | umami
NEXT_PUBLIC_ANALYTICS=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# ---- Accounts + price alerts (server-only secrets) ----
AUTH_SECRET=                           # 32+ random characters; keys the one-time email codes (required in production)
DATABASE_URL=                          # Postgres (required for accounts and alerts; schema is created automatically)
                                       # Supabase: Connect > Transaction pooler URI (port 6543)
DATABASE_CA_CERT=                      # PEM of the provider's CA (Supabase: Settings > Database > SSL > Download certificate)
# eBay Developer production keyset (App ID + Cert ID). Missing = prices show "coming soon"
# and the sync reports PENDING_CREDENTIALS.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
PRICE_SYNC_ENABLED=                    # set to "false" to pause the daily price sync
PRICE_MARKETS=EBAY_US                  # comma-separated: EBAY_US, EBAY_GB, EBAY_DE
RESEND_API_KEY=
EMAIL_FROM="TinyLab Finder <alerts@example.com>"
CRON_SECRET=                           # long random string; the scheduler sends it as a Bearer token

# ---- Monitoring (optional) ----
ERROR_WEBHOOK_URL=                     # Slack/Discord/any JSON webhook for server errors (logs always go to Vercel)
